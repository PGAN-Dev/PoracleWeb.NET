<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <InternalsVisibleTo Include="Pgan.PoracleWebNet.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!--
      Direct pin to clear NU1903 (GHSA-v5pm-xwqc-g5wc, high): a circular schema reference can
      terminate OpenAPI parsing. Microsoft.OpenApi is vulnerable at >= 2.0.0-preview.11 and
      <= 2.7.4; 2.7.5 is the first patched release.

      Microsoft.AspNetCore.OpenApi 10.0.10 still pins Microsoft.OpenApi 2.0.0 transitively, so
      the advisory is not cleared by bumping the ASP.NET Core package: 10.0.8 and 10.0.10 pull
      the same 2.0.0. This direct reference is the only way to raise it, and can be dropped once
      Microsoft.AspNetCore.OpenApi ships a patched floor of its own.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Pgan.PoracleWebNet.Core.Abstractions\Pgan.PoracleWebNet.Core.Abstractions.csproj" />
    <ProjectReference Include="..\..\Core\Pgan.PoracleWebNet.Core.Mappings\Pgan.PoracleWebNet.Core.Mappings.csproj" />
    <ProjectReference Include="..\..\Core\Pgan.PoracleWebNet.Core.Models\Pgan.PoracleWebNet.Core.Models.csproj" />
    <ProjectReference Include="..\..\Core\Pgan.PoracleWebNet.Core.Repositories\Pgan.PoracleWebNet.Core.Repositories.csproj" />
    <ProjectReference Include="..\..\Core\Pgan.PoracleWebNet.Core.Services\Pgan.PoracleWebNet.Core.Services.csproj" />
    <ProjectReference Include="..\..\Data\Pgan.PoracleWebNet.Data\Pgan.PoracleWebNet.Data.csproj" />
    <ProjectReference Include="..\..\Data\Pgan.PoracleWebNet.Data.Scanner\Pgan.PoracleWebNet.Data.Scanner.csproj" />
  </ItemGroup>

</Project>
