{
 "info": {
  "title": "PoracleNG API",
  "version": "5.2.1"
 },
 "paths": {
  "/v2/humans": {
   "post": {
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/V2HumanResourceBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    }
   }
  },
  "/v2/humans/{id}": {
   "get": {
    "description": "Returns the full human resource. blocked_alerts is a read-only derived field. 404 if the human does not exist.",
    "operationId": "v2-get-human",
    "parameters": [
     {
      "description": "Human id (the owning user)",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id (the owning user)",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/V2HumanResourceBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Fetch one human",
    "tags": [
     "v2-humans"
    ]
   }
  },
  "/v2/humans/{id}/profiles": {
   "get": {
    "description": "Returns every profile for the human (profile_no, name, area, location, active_hours). active_hours is a typed JSON array of schedule entries ([] when no schedule is set). 404 if the human does not exist.",
    "operationId": "v2-list-human-profiles",
    "parameters": [
     {
      "description": "Human id (the owning user)",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id (the owning user)",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/V2ProfilesOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "List a human's profiles",
    "tags": [
     "v2-profiles"
    ]
   },
   "post": {
    "description": "Creates a new profile (profile_no auto-assigned). active_hours, if provided, is validated against the strict schema (numeric bounds + step/end cross-field, no cross-midnight) and stored as JSON. 422 if the name is empty or active_hours is invalid; 404 if the human does not exist. Triggers a state reload.",
    "operationId": "v2-add-human-profile",
    "parameters": [
     {
      "description": "Human id (the owning user)",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id (the owning user)",
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/V2AddProfileBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOKOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Create a profile",
    "tags": [
     "v2-profiles"
    ]
   }
  },
  "/v2/humans/{id}/areas": {
   "get": {
    "description": "Returns the geofence areas available to this human (community-filtered when area_security is enabled). 404 if the human does not exist.",
    "operationId": "v2-get-human-areas",
    "parameters": [
     {
      "description": "Human id (the owning user)",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id (the owning user)",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/V2AreasOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "List a human's available areas",
    "tags": [
     "v2-humans"
    ]
   },
   "post": {
    "description": "Intersects the requested areas with what the human is allowed to select (userSelectable for non-admins, community-filtered when area_security is enabled), dedups, lowercases, and stores the result. Triggers a state reload. 404 if the human does not exist.",
    "operationId": "v2-set-human-areas",
    "parameters": [
     {
      "description": "Human id (the owning user)",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id (the owning user)",
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/V2SetAreasBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOKOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Set a human's selected areas",
    "tags": [
     "v2-humans"
    ]
   }
  },
  "/v2/humans/{id}/location": {
   "post": {
    "description": "lat/lon are taken from the BODY (v1 took them from the path). When area_security is enabled and the human has an area restriction, the location must fall inside an allowed fence (403 otherwise). Triggers a state reload. 404 if the human does not exist.",
    "operationId": "v2-set-human-location",
    "parameters": [
     {
      "description": "Human id (the owning user)",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id (the owning user)",
       "type": "string"
      }
     },
     {
      "description": "Profile number; defaults to the human's active profile",
      "explode": false,
      "in": "query",
      "name": "profile",
      "schema": {
       "default": -1,
       "description": "Profile number; defaults to the human's active profile",
       "format": "int64",
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/V2LocationBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOKOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Set a human's location",
    "tags": [
     "v2-humans"
    ]
   }
  },
  "/v2/humans/{id}/profiles/{profile_no}": {
   "delete": {
    "description": "Deletes the profile and its tracking data. The store reassigns the human's active profile when the deleted one was active (mirrors v1). 404 if the human does not exist. Triggers a state reload.",
    "operationId": "v2-delete-human-profile",
    "parameters": [
     {
      "description": "Human id (the owning user)",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id (the owning user)",
       "type": "string"
      }
     },
     {
      "description": "Profile number to delete",
      "in": "path",
      "name": "profile_no",
      "required": true,
      "schema": {
       "description": "Profile number to delete",
       "format": "int64",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOKOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Delete a profile",
    "tags": [
     "v2-profiles"
    ]
   },
   "patch": {
    "description": "Replaces the profile's active-hours schedule. The schedule is validated against the strict schema (numeric bounds + step/end cross-field, no cross-midnight); an empty [] clears the schedule. 422 on an invalid schedule; 404 if the human does not exist. Triggers a state reload.",
    "operationId": "v2-update-human-profile",
    "parameters": [
     {
      "description": "Human id (the owning user)",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id (the owning user)",
       "type": "string"
      }
     },
     {
      "description": "Profile number to update",
      "in": "path",
      "name": "profile_no",
      "required": true,
      "schema": {
       "description": "Profile number to update",
       "format": "int64",
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/V2UpdateProfileBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOKOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Update a profile's active_hours",
    "tags": [
     "v2-profiles"
    ]
   }
  },
  "/v2/humans/{id}/profiles/{profile_no}/copy": {
   "post": {
    "description": "Copies all tracking rules from from_profile (body) into the {profile_no} destination, replacing the destination's existing rules (mirrors v1 CopyProfile). 404 if the human does not exist. Triggers a state reload.",
    "operationId": "v2-copy-human-profile",
    "parameters": [
     {
      "description": "Human id (the owning user)",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id (the owning user)",
       "type": "string"
      }
     },
     {
      "description": "Destination profile number to copy tracking rules INTO",
      "in": "path",
      "name": "profile_no",
      "required": true,
      "schema": {
       "description": "Destination profile number to copy tracking rules INTO",
       "format": "int64",
       "type": "integer"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/V2CopyProfileBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOKOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Copy tracking rules between profiles",
    "tags": [
     "v2-profiles"
    ]
   }
  }
 },
 "components": {
  "schemas": {
   "V2SetAreasBody": {
    "additionalProperties": false,
    "properties": {
     "areas": {
      "description": "Requested area names; intersected with the human's allowed areas (invalid/duplicate entries dropped)",
      "items": {
       "type": "string"
      },
      "type": [
       "array",
       "null"
      ]
     }
    },
    "required": [
     "areas"
    ],
    "type": "object"
   },
   "V2UpdateProfileBody": {
    "additionalProperties": false,
    "properties": {
     "active_hours": {
      "description": "New active-hours schedule ([] clears it). Validated against the strict schema.",
      "items": {
       "$ref": "#/components/schemas/V2ActiveHourEntry"
      },
      "type": [
       "array",
       "null"
      ]
     }
    },
    "required": [
     "active_hours"
    ],
    "type": "object"
   },
   "V2InvasionRule": {
    "additionalProperties": false,
    "properties": {
     "boss": {
      "description": "Catch-all for boss encounters: set true to match only boss invasions (stored grunt_type \"boss\"). One-of mode field. Mutually exclusive with the others; gender not allowed.",
      "type": "boolean"
     },
     "clean": {
      "description": "Auto-delete the alert on expiry (clean bitmask bit 1). Omit to disable (default false). Returned as null when false.",
      "type": [
       "boolean",
       "null"
      ]
     },
     "distance": {
      "description": "Radius in metres around the anchor location. Omit (or 0) to match by the profile's geofence areas instead of a radius \u2014 0 means area-based, NOT zero metres (stored as 0). Returned as null when at its wildcard.",
      "format": "int64",
      "type": [
       "integer",
       "null"
      ]
     },
     "edit": {
      "description": "Keep the message updated in place (clean bitmask bit 2). Omit to disable (default false). Returned as null when false.",
      "type": [
       "boolean",
       "null"
      ]
     },
     "everything": {
      "description": "Catch-all wildcard: set true to match EVERY invasion (stored grunt_type \"everything\"). This is the 'any invasion' selector \u2014 there is no omit-to-wildcard on invasion (exactly one mode field must be set). Mutually exclusive with the others; gender not allowed.",
      "type": "boolean"
     },
     "gender": {
      "description": "Grunt gender filter: any|male|female. Omit to match any gender (defaults to 'any', stored as 0). ONLY valid together with type_id. Returned as null when 'any' (or when not in type_id mode).",
      "enum": [
       "any",
       "male",
       "female"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "grunt_id": {
      "description": "Game-master grunt id; resolves to its type name and implies its own gender. One-of mode field. Mutually exclusive with type_id/everything/boss; gender not allowed. (On read-back a grunt_id rule is reported as type_id+gender, faithful to what is stored.)",
      "format": "int64",
      "type": "integer"
     },
     "override_areas": {
      "description": "Restrict this rule to these geofence areas (mutually exclusive with distance > 0 and override_location_label). Omit for none. Returned as null when unset.",
      "items": {
       "type": "string"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "override_location_label": {
      "description": "Saved-location label to use instead of the profile location (requires distance > 0; mutually exclusive with override_areas). Omit for none. Returned as null when unset.",
      "type": [
       "string",
       "null"
      ]
     },
     "summary": {
      "description": "Route into the summary digest (clean bitmask bit 4). Omit to disable (default false). Returned as null when false.",
      "type": [
       "boolean",
       "null"
      ]
     },
     "template": {
      "description": "DTS template name. Omit (or empty) to use the server's configured default template (stored as \"\"). Returned as null when at its wildcard.",
      "type": [
       "string",
       "null"
      ]
     },
     "type_id": {
      "description": "Pokemon type id (1-18); grunt_type resolves to that type's lowercased name. EXACTLY ONE mode field required \u2014 set this OR grunt_id OR everything OR boss (not omitted-to-wildcard; use everything for the catch-all). Mutually exclusive with grunt_id/everything/boss. In responses, the active mode field is always present; the other mode fields are omitted/null.",
      "format": "int64",
      "type": "integer"
     }
    },
    "type": "object"
   },
   "StatusOKOutputBody": {
    "additionalProperties": false,
    "properties": {
     "status": {
      "description": "Always \"ok\" on success",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "V2LocationBody": {
    "additionalProperties": false,
    "properties": {
     "lat": {
      "description": "Latitude",
      "format": "double",
      "type": "number"
     },
     "lon": {
      "description": "Longitude",
      "format": "double",
      "type": "number"
     }
    },
    "required": [
     "lat",
     "lon"
    ],
    "type": "object"
   },
   "V2AddLocationBody": {
    "additionalProperties": false,
    "properties": {
     "label": {
      "description": "Unique saved-location label",
      "type": "string"
     },
     "lat": {
      "description": "Latitude",
      "format": "double",
      "type": "number"
     },
     "lon": {
      "description": "Longitude",
      "format": "double",
      "type": "number"
     }
    },
    "required": [
     "label",
     "lat",
     "lon"
    ],
    "type": "object"
   },
   "V2UpdateLocationBody": {
    "additionalProperties": false,
    "properties": {
     "lat": {
      "description": "New latitude",
      "format": "double",
      "type": "number"
     },
     "lon": {
      "description": "New longitude",
      "format": "double",
      "type": "number"
     }
    },
    "required": [
     "lat",
     "lon"
    ],
    "type": "object"
   },
   "V2ActiveHourEntry": {
    "additionalProperties": false,
    "properties": {
     "day": {
      "description": "Day of week (0=Sunday \u2026 6=Saturday)",
      "format": "int64",
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     "end_hours": {
      "description": "End hour (0\u201323); required when step>0",
      "format": "int64",
      "maximum": 23,
      "minimum": 0,
      "type": "integer"
     },
     "end_mins": {
      "description": "End minute (0\u201359); required when step>0",
      "format": "int64",
      "maximum": 59,
      "minimum": 0,
      "type": "integer"
     },
     "hours": {
      "description": "Start hour (0\u201323)",
      "format": "int64",
      "maximum": 23,
      "minimum": 0,
      "type": "integer"
     },
     "mins": {
      "description": "Start minute (0\u201359)",
      "format": "int64",
      "maximum": 59,
      "minimum": 0,
      "type": "integer"
     },
     "step": {
      "description": "Step in hours; >0 makes this a range entry, 0/absent = single-fire",
      "format": "int64",
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "day",
     "hours",
     "mins"
    ],
    "type": "object"
   },
   "V2AddProfileBody": {
    "additionalProperties": false,
    "properties": {
     "active_hours": {
      "description": "Optional active-hours schedule (absent or [] = no schedule)",
      "items": {
       "$ref": "#/components/schemas/V2ActiveHourEntry"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "name": {
      "description": "Profile name (required, non-empty)",
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "V2AreaInfo": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "type": "string"
     },
     "group": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "userSelectable": {
      "type": "boolean"
     }
    },
    "required": [
     "name",
     "group",
     "description",
     "userSelectable"
    ],
    "type": "object"
   },
   "V2AreasOutputBody": {
    "additionalProperties": false,
    "properties": {
     "areas": {
      "items": {
       "$ref": "#/components/schemas/V2AreaInfo"
      },
      "type": [
       "array",
       "null"
      ]
     }
    },
    "required": [
     "areas"
    ],
    "type": "object"
   },
   "V2CopyProfileBody": {
    "additionalProperties": false,
    "properties": {
     "from_profile": {
      "description": "Source profile number to copy tracking rules FROM",
      "format": "int64",
      "type": "integer"
     }
    },
    "required": [
     "from_profile"
    ],
    "type": "object"
   },
   "V2ProfileResponse": {
    "additionalProperties": false,
    "properties": {
     "active_hours": {
      "description": "Auto-switch schedule as a typed array. Always [] when unscheduled (never null, never a string).",
      "items": {
       "$ref": "#/components/schemas/V2ActiveHourEntry"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "area": {
      "description": "Profile geofence-area override as a JSON-encoded string array (legacy encoding retained on this field) \u2014 \"[]\" when the profile has no area override.",
      "type": "string"
     },
     "id": {
      "description": "Owning human id.",
      "type": "string"
     },
     "latitude": {
      "description": "Profile location-override latitude. 0 when the profile has no location override.",
      "format": "double",
      "type": "number"
     },
     "longitude": {
      "description": "Profile location-override longitude. 0 when the profile has no location override.",
      "format": "double",
      "type": "number"
     },
     "name": {
      "description": "Profile display name.",
      "type": "string"
     },
     "profile_no": {
