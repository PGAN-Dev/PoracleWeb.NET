{
 "components": {
  "schemas": {
   "StatusOKOutputBody": {
    "additionalProperties": false,
    "properties": {
     "status": {
      "description": "Always \"ok\" on success",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "V2AccountItem": {
    "additionalProperties": false,
    "properties": {
     "created_at": {
      "description": "When the account was linked.",
      "format": "date-time",
      "type": "string"
     },
     "label": {
      "description": "Optional label, unique per human (case-insensitive). null when unset.",
      "type": [
       "string",
       "null"
      ]
     },
     "player_id": {
      "description": "Game player ID: 1-256 ASCII letters or digits, case-sensitive.",
      "type": "string"
     }
    },
    "required": [
     "player_id",
     "label",
     "created_at"
    ],
    "type": "object"
   },
   "V2AccountsOutputBody": {
    "additionalProperties": false,
    "properties": {
     "accounts": {
      "items": {
       "$ref": "#/components/schemas/V2AccountItem"
      },
      "type": [
       "array",
       "null"
      ]
     }
    },
    "required": [
     "accounts"
    ],
    "type": "object"
   },
   "V2AddAccountBody": {
    "additionalProperties": false,
    "properties": {
     "label": {
      "description": "Optional label, unique per human.",
      "maxLength": 64,
      "type": "string"
     },
     "player_id": {
      "description": "Game player ID: 1-256 ASCII letters or digits, case-sensitive.",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9]+$",
      "type": "string"
     }
    },
    "required": [
     "player_id"
    ],
    "type": "object"
   },
   "V2AddAccountOutputBody": {
    "additionalProperties": false,
    "properties": {
     "account": {
      "$ref": "#/components/schemas/V2AccountItem"
     }
    },
    "required": [
     "account"
    ],
    "type": "object"
   },
   "V2LabelAccountBody": {
    "additionalProperties": false,
    "properties": {
     "label": {
      "description": "New label; empty clears it.",
      "maxLength": 64,
      "type": "string"
     }
    },
    "required": [
     "label"
    ],
    "type": "object"
   },
   "V2PokemonRule": {
    "additionalProperties": false,
    "properties": {
     "personal_background": {
      "description": "Only alert when the pokemon has the special (event) background for one of the human's linked accounts (personal bitmask bit 2). Same requirements as personal_shiny; when both are set both must hold. Omit for false. Returned as null when false.",
      "type": [
       "boolean",
       "null"
      ]
     },
     "personal_shiny": {
      "description": "Only alert when the pokemon is shiny for one of the human's linked game accounts (personal bitmask bit 1). Needs the server's [shiny_rates] feed; matches nothing until it loads or while the human has no linked accounts. Omit for false. Returned as null when false.",
      "type": [
       "boolean",
       "null"
      ]
     },
     "ping": {
      "description": "Text appended to the alert, typically Discord role/user mentions. Stored verbatim \u2014 not restricted to mention tokens as the bot is, so @everyone/@here in a channel rule will ping. Omit for none. Returned as null when empty.",
      "maxLength": 255,
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   }
  }
 },
 "info": {
  "title": "PoracleNG API",
  "version": "5.3.0"
 },
 "paths": {
  "/v2/humans/{id}/accounts": {
   "get": {
    "operationId": "v2-list-human-accounts",
    "parameters": [
     {
      "description": "Human id",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/V2AccountsOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "List a human's linked game accounts",
    "tags": [
     "v2-accounts"
    ]
   },
   "post": {
    "description": "Links a player ID to the human. 409 if the player ID or label is already linked to this human; 422 when invalid or over the 50-account limit. Triggers a state reload.",
    "operationId": "v2-add-human-account",
    "parameters": [
     {
      "description": "Human id",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id",
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/V2AddAccountBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/V2AddAccountOutputBody"
        }
       }
      },
      "description": "Created"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Link a game account",
    "tags": [
     "v2-accounts"
    ]
   }
  },
  "/v2/humans/{id}/accounts/{player_id}": {
   "delete": {
    "operationId": "v2-delete-human-account",
    "parameters": [
     {
      "description": "Human id",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id",
       "type": "string"
      }
     },
     {
      "description": "Game player ID (ASCII letters or digits, case-sensitive).",
      "in": "path",
      "name": "player_id",
      "required": true,
      "schema": {
       "description": "Game player ID (ASCII letters or digits, case-sensitive).",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOKOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Unlink a game account",
    "tags": [
     "v2-accounts"
    ]
   },
   "put": {
    "operationId": "v2-label-human-account",
    "parameters": [
     {
      "description": "Human id",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "description": "Human id",
       "type": "string"
      }
     },
     {
      "description": "Game player ID (ASCII letters or digits, case-sensitive).",
      "in": "path",
      "name": "player_id",
      "required": true,
      "schema": {
       "description": "Game player ID (ASCII letters or digits, case-sensitive).",
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/V2LabelAccountBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StatusOKOutputBody"
        }
       }
      },
      "description": "OK"
     },
     "default": {
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorModel"
        }
       }
      },
      "description": "Error"
     }
    },
    "security": [
     {
      "poracleSecret": []
     }
    ],
    "summary": "Set or clear a linked account's label",
    "tags": [
     "v2-accounts"
    ]
   }
  }
 },
 "x-source": "hand-trimmed from jfberry/PoracleNG feat/personal-shiny source @ 37cc7a33; replace with a live capture"
}
